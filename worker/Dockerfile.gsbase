# Stage 1: AOT compile gsplat v1.5.3 CUDA 12.8 extension (Ampere, Ada, Hopper, Blackwell)
FROM pytorch/pytorch:2.8.0-cuda12.8-cudnn9-devel AS gsplat-builder

ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9;9.0;12.0+PTX" \
    MAX_JOBS=2

RUN apt-get update && apt-get install -y --no-install-recommends build-essential git ninja-build \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN git clone --depth 1 --branch v1.5.3 --recursive https://github.com/nerfstudio-project/gsplat.git \
    && pip wheel --no-cache-dir --no-build-isolation --no-deps -w /wheels ./gsplat \
    && ls -lh /wheels

# Stage 2: Lean runtime image (CUDA 12.8 + PyTorch 2.8 + MapAnything + AOT gsplat)
FROM ghcr.io/coskunerberke/mobilya-ar-worker:cu128
LABEL org.opencontainers.image.source="https://github.com/CoskunerBerke/MobilyaAR"

COPY --from=gsplat-builder /wheels/*.whl /tmp/
RUN pip install --no-cache-dir --no-deps /tmp/gsplat-*.whl \
    && pip install --no-cache-dir jaxtyping rich typing_extensions \
    && rm -f /tmp/gsplat-*.whl \
    && python -c "import glob, os, gsplat; sos = glob.glob(os.path.join(os.path.dirname(gsplat.__file__), 'csrc*.so')); print('gsplat:', gsplat.__version__, 'AOT .so:', sos); assert len(sos) >= 1, 'gsplat CUDA .so missing!'"
